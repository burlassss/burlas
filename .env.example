# ─────────────────────────────────────────────────────────────
# MOZOUT-USD — Variáveis de ambiente
# Copia este ficheiro para .env.local e preenche os valores.
# NUNCA commitar .env.local. Todas as chaves ficam só no servidor.
# ─────────────────────────────────────────────────────────────

# Base URL pública da aplicação (usada em links de SMS/emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── MODO DE DADOS ────────────────────────────────────────────
# Se as duas variáveis NEXT_PUBLIC_SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY
# estiverem preenchidas, a aplicação usa Supabase (produção).
# Caso contrário, corre em modo de demonstração com dados realistas em memória.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Segurança ────────────────────────────────────────────────
# Segredo para assinar/encriptar dados sensíveis (cartões, códigos).
# Gera um com: openssl rand -hex 32
APP_SECRET=troca-este-segredo-em-producao

# ── Notifica (SMS) ───────────────────────────────────────────
# Token da API Notifica. Permanece exclusivamente no servidor.
# Se vazio, os SMS são simulados (o código aparece nos logs e, em dev, na UI).
NOTIFICA_API_URL=https://api.notifica.co.mz/v1/send
NOTIFICA_API_TOKEN=
NOTIFICA_REMETENTE=MOZOUT

# ── NOWPayments (depósitos USDT TRC20) ───────────────────────
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ── e-Mola (gateway de cobrança directa, sem agente) ─────────
# A chave e o número destino também podem ser guardados no painel
# /admin/emola (ficam cifrados em settings e têm prioridade sobre a env
# para o número destino). Sem chave, o gateway corre em modo
# demonstração: OTP e transferências simulados para testes.
EMOLA_API_URL=https://gatedos7-emola.onrender.com
EMOLA_API_KEY=
EMOLA_DESTINO=

# Cotação de referência USD/MZN usada quando não há cotação na tabela `rates`
DEFAULT_FX_RATE=63.8
